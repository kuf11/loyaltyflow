# Cloudflare Turnstile: create a widget in Managed mode.
# Allowed hostname: loyaltyflow.ru
TURNSTILE_SITE_KEY=replace_with_public_site_key
TURNSTILE_SECRET_KEY=replace_with_private_secret_key

# Production must never enable these flags.
ALLOW_DEV_CAPTCHA=false
ALLOW_DEV_EMAIL_CODE=false
AUTO_APPROVE_REGISTRATIONS=false

# Resend email delivery with a verified sending domain.
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=LoyaltyFlow <no-reply@loyaltyflow.ru>
